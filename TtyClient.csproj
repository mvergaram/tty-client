<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TtyClient</AssemblyName>
    <Product>TTY Client</Product>
    <AssemblyTitle>TTY Client</AssemblyTitle>
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TtyClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TtyClient.Tests\**" />
    <EmbeddedResource Remove="TtyClient.Tests\**" />
    <None Remove="TtyClient.Tests\**" />
    <Page Remove="TtyClient.Tests\**" />
  </ItemGroup>

</Project>
