<Window x:Class="TtyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTY Dynamic Client — Skype for Business"
        Icon="Assets/icon.ico"
        Height="560" Width="700"
        MinHeight="420" MinWidth="500"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SendButton">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4D0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Items in a ComboBox's open dropdown render on the system's light popup
             background, so they need their own dark/black foreground — the lavender
             foreground used for the closed box would look washed-out/gray there. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- The default ComboBox template renders the closed-box selected value using
             these SystemColors brush keys directly, ignoring the control's own Foreground
             property. Overriding the keys (scoped to ComboBox via Style.Resources) is the
             actual fix for the selected text showing as gray instead of black. -->
        <Style TargetType="ComboBox">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="Black"/>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="TTY Client" FontSize="20" FontWeight="Bold"
                       Foreground="#CDD6F4" VerticalAlignment="Center"/>
            <TextBlock Text="  ·  Skype for Business" FontSize="13"
                       Foreground="#6C7086" VerticalAlignment="Center" Margin="4,2,0,0"/>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="#313244" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="#F38BA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusLabel" Text="Detenido"
                               Foreground="#CDD6F4" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="DeviceLabel" Grid.Column="1"
                           Text="—" Foreground="#6C7086" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Received text -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="6"
                BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#313244" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="RECIBIDO" Foreground="#A6E3A1" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="ReceivedScroller"
                              VerticalScrollBarVisibility="Auto" Padding="10">
                    <TextBlock x:Name="ReceivedText"
                               Foreground="#CDD6F4" FontFamily="Consolas"
                               FontSize="14" TextWrapping="Wrap"
                               Text=""/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Send area -->
        <Border Grid.Row="3" Background="#181825" CornerRadius="6"
                BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#313244" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="ENVIAR" Foreground="#89B4FA" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <Grid Grid.Row="1" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SendInput"
                             Background="#1E1E2E" Foreground="#CDD6F4"
                             BorderThickness="1" BorderBrush="#45475A"
                             Padding="8,6" FontFamily="Consolas" FontSize="14"
                             CaretBrush="#CDD6F4"
                             KeyDown="SendInput_KeyDown"
                             MaxLength="512"/>
                    <Button Grid.Column="1" Content="Enviar (Enter)"
                            Style="{StaticResource SendButton}"
                            Margin="8,0,0,0"
                            x:Name="BtnSend"
                            Click="BtnSend_Click"
                            IsEnabled="False"/>
                    <Button Grid.Column="2" Content="Guardar WAV"
                            Style="{StaticResource ActionButton}"
                            Margin="6,0,0,0"
                            x:Name="BtnSaveWav"
                            Click="BtnSaveWav_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Device selectors -->
        <Border Grid.Row="4" Background="#313244" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Entrada de audio:" Foreground="#6C7086"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="InputDeviceCombo" Grid.Row="0" Grid.Column="1"
                          Background="#1E1E2E" Foreground="Black"
                          BorderBrush="#45475A" FontSize="12"
                          Padding="6,4" DisplayMemberPath="DisplayName"/>
                <Button x:Name="BtnRefreshInputDevices" Grid.Row="0" Grid.Column="2" Content="Actualizar"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0" FontSize="12"
                        Click="BtnRefreshInputDevices_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Salida de audio:" Foreground="#6C7086"
                           FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0"/>
                <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.Column="1"
                          Background="#1E1E2E" Foreground="Black"
                          BorderBrush="#45475A" FontSize="12"
                          Padding="6,4" Margin="0,8,0,0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Actualizar"
                        Style="{StaticResource ActionButton}"
                        Margin="8,8,0,0" FontSize="12"
                        Click="BtnRefreshDevices_Click"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnImportWav" Content="Importar WAV"
                        Style="{StaticResource ActionButton}"
                        Click="BtnImportWav_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnClear" Content="Limpiar"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0" Click="BtnClear_Click"/>
                <Button x:Name="BtnStop" Content="Detener"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0" Click="BtnStop_Click"
                        IsEnabled="False"/>
                <Button x:Name="BtnStart" Content="Iniciar escucha"
                        Style="{StaticResource SendButton}"
                        Click="BtnStart_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
