<Window x:Class="TtyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TtyClient.Views"
        Title="TTY Dynamic Client"
        Icon="Assets/icon.ico"
        Height="560" Width="700"
        MinHeight="420" MinWidth="500"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="TTY Client" FontSize="20" FontWeight="Bold"
                       Foreground="#CDD6F4" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="Call Conversation">
                <views:CallConversationView x:Name="CallView" Margin="12"/>
            </TabItem>
            <TabItem Header="Audio Files">
                <views:AudioFilesView x:Name="FilesView" Margin="12"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
