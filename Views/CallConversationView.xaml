<UserControl x:Class="TtyClient.Views.CallConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="#F38BA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusLabel" Text="Stopped"
                               Foreground="#CDD6F4" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="DeviceLabel" Grid.Column="1"
                           Text="—" Foreground="#6C7086" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Received text -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="6"
                BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#313244">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="6,0,0,0" Padding="10,6">
                        <TextBlock Text="RECEIVED" Foreground="#A6E3A1" FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Button Grid.Column="1" Content="Clear"
                            Style="{StaticResource ActionButton}"
                            Padding="10,3" FontSize="11" Margin="0,4,4,4"
                            Click="BtnClear_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="ReceivedScroller"
                              VerticalScrollBarVisibility="Auto" Padding="10">
                    <TextBlock x:Name="ReceivedText"
                               Foreground="#CDD6F4" FontFamily="Consolas"
                               FontSize="14" TextWrapping="Wrap"
                               Text=""/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Send area -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="6"
                BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#313244" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="SEND" Foreground="#89B4FA" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <Grid Grid.Row="1" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SendInput"
                             Background="#1E1E2E" Foreground="#CDD6F4"
                             BorderThickness="1" BorderBrush="#45475A"
                             Padding="8,6" FontFamily="Consolas" FontSize="14"
                             CaretBrush="#CDD6F4"
                             KeyDown="SendInput_KeyDown"
                             MaxLength="512"/>
                    <Button Grid.Column="1" Content="Send (Enter)"
                            Style="{StaticResource SendButton}"
                            Margin="8,0,0,0"
                            x:Name="BtnSend"
                            Click="BtnSend_Click"
                            IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Device selectors -->
        <Border Grid.Row="3" Background="#313244" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio input:" Foreground="#6C7086"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="InputDeviceCombo" Grid.Row="0" Grid.Column="1"
                          Background="#1E1E2E" Foreground="Black"
                          BorderBrush="#45475A" FontSize="12"
                          Padding="6,4" DisplayMemberPath="DisplayName"/>
                <Button x:Name="BtnRefreshInputDevices" Grid.Row="0" Grid.Column="2" Content="Refresh"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0" FontSize="12"
                        Click="BtnRefreshInputDevices_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Audio output:" Foreground="#6C7086"
                           FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0"/>
                <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.Column="1"
                          Background="#1E1E2E" Foreground="Black"
                          BorderBrush="#45475A" FontSize="12"
                          Padding="6,4" Margin="0,8,0,0"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Refresh"
                        Style="{StaticResource ActionButton}"
                        Margin="8,8,0,0" FontSize="12"
                        Click="BtnRefreshDevices_Click"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnStop" Content="Stop"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,8,0" Click="BtnStop_Click"
                        IsEnabled="False"/>
                <Button x:Name="BtnStart" Content="Start listening"
                        Style="{StaticResource SendButton}"
                        Click="BtnStart_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
