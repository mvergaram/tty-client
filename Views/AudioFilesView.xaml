<UserControl x:Class="TtyClient.Views.AudioFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Text to convert -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="6"
                BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#313244" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="TEXT TO CONVERT" Foreground="#89B4FA" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <Grid Grid.Row="1" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInput"
                             Background="#1E1E2E" Foreground="#CDD6F4"
                             BorderThickness="1" BorderBrush="#45475A"
                             Padding="8,6" FontFamily="Consolas" FontSize="14"
                             CaretBrush="#CDD6F4"
                             MaxLength="512"/>
                    <Button Grid.Column="1" Content="Save WAV"
                            Style="{StaticResource ActionButton}"
                            Margin="8,0,0,0"
                            x:Name="BtnSaveWav"
                            Click="BtnSaveWav_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Imported WAV transcript -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="6"
                BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#313244">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="6,0,0,0" Padding="10,6">
                        <TextBlock Text="TRANSCRIPT" Foreground="#A6E3A1" FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Button Grid.Column="1" Content="Clear"
                            Style="{StaticResource ActionButton}"
                            Padding="10,3" FontSize="11" Margin="0,4,4,4"
                            Click="BtnClear_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="TranscriptScroller"
                              VerticalScrollBarVisibility="Auto" Padding="10">
                    <TextBlock x:Name="TranscriptText"
                               Foreground="#CDD6F4" FontFamily="Consolas"
                               FontSize="14" TextWrapping="Wrap"
                               Text=""/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnImportWav" Content="Import WAV"
                        Style="{StaticResource ActionButton}"
                        Click="BtnImportWav_Click"/>
                <TextBlock x:Name="StatusLabel" Text=""
                           Foreground="#6C7086" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
