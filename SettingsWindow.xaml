<Window x:Class="TtyClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="Assets/icon.ico"
        Height="520" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Silent hops to reset FIGS shift"
                   Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HopsInput" Grid.Column="0"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="1" BorderBrush="#45475A"
                     Padding="8,6" FontFamily="Consolas" FontSize="14"
                     CaretBrush="#CDD6F4"
                     MaxLength="9"
                     PreviewTextInput="HopsInput_PreviewTextInput"
                     TextChanged="HopsInput_TextChanged"/>
            <TextBlock x:Name="SecondsLabel" Grid.Column="1"
                       Foreground="#6C7086" FontSize="13"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <CheckBox Grid.Row="2" x:Name="AiImprovedTextCheckBox"
                  Content="Improve received text with AI"
                  Foreground="#CDD6F4" FontSize="13"
                  Margin="0,16,0,0" VerticalContentAlignment="Center"
                  Checked="AiImprovedTextCheckBox_CheckedChanged"
                  Unchecked="AiImprovedTextCheckBox_CheckedChanged"/>

        <StackPanel Grid.Row="3" x:Name="AiFieldsPanel" Margin="0,12,0,0">
            <TextBlock Text="AI endpoint URL" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="AiUrlInput"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="1" BorderBrush="#45475A"
                     Padding="8,6" FontFamily="Consolas" FontSize="13"
                     CaretBrush="#CDD6F4" Margin="0,0,0,10"/>

            <TextBlock Text="API key" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="AiApiKeyInput"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="1" BorderBrush="#45475A"
                     Padding="8,6" FontFamily="Consolas" FontSize="13"
                     CaretBrush="#CDD6F4" Margin="0,0,0,10"/>

            <TextBlock Text="Provider" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="AiProviderInput"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="1" BorderBrush="#45475A"
                     Padding="8,6" FontFamily="Consolas" FontSize="13"
                     CaretBrush="#CDD6F4" Margin="0,0,0,10"/>

            <TextBlock Text="Model" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="AiModelInput"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="1" BorderBrush="#45475A"
                     Padding="8,6" FontFamily="Consolas" FontSize="13"
                     CaretBrush="#CDD6F4"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource ActionButton}"
                    Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Save" Style="{StaticResource SendButton}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
